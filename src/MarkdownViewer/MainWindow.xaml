<Window x:Class="MarkdownViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Markdown Viewer" Icon="pack://application:,,,/MarkdownViewer;component/Assets/MarkdownViewer.ico" Width="1100" Height="780" MinWidth="640" MinHeight="450"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
 AllowDrop="True" PreviewDrop="Window_Drop" PreviewDragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown"
 PreviewMouseDown="Window_PreviewMouseDown"
 Closing="Window_Closing" SizeChanged="Window_SizeChanged" SourceInitialized="Window_SourceInitialized"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="WindowContent" Background="{DynamicResource WindowBrush}" SizeChanged="WindowContent_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Height="44" Background="{DynamicResource ChromeBrush}">
    <Grid.Resources>
     <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
     <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
     <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
     <Style x:Key="TabScrollButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource ScrollLineButtonStyle}"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="32"/><Setter Property="Background" Value="Transparent"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,4,0,4">
     <Button x:Name="OpenButton" Content="{StaticResource FileOpenIcon}" ContentTemplate="{StaticResource ToolbarIconTemplate}" Padding="5,3" MinWidth="36" Click="Open_Click" ToolTip="Open files (Ctrl+O)" AutomationProperties.Name="Open files"/>
     <Button x:Name="RecentButton" Content="▾" Click="Recent_Click" ToolTip="Recent files" AutomationProperties.Name="Recent files" Padding="5,6"/>
     <Border Width="1" Margin="7,5" Background="{DynamicResource LineBrush}"/>
     <ToggleButton x:Name="OutlineToggle" Content="{StaticResource TocIcon}" ContentTemplate="{StaticResource ToolbarIconTemplate}" Padding="5,3" MinWidth="36" Click="Outline_Click" ToolTip="Table of contents (Ctrl+Shift+O)" AutomationProperties.Name="Table of contents"/>
     <Button x:Name="FindButton" Content="{StaticResource SearchIcon}" ContentTemplate="{StaticResource ToolbarIconTemplate}" Padding="5,3" MinWidth="36" Click="Find_Click" ToolTip="Find in document (Ctrl+F)" AutomationProperties.Name="Find in document"/>
    </StackPanel>
    <ListBox x:Name="TabsList" Grid.Column="1" Margin="8,4" VerticalAlignment="Center" MinWidth="0" ItemsSource="{Binding Tabs}" SelectionChanged="Tabs_SelectionChanged" SizeChanged="Tabs_SizeChanged" PreviewMouseWheel="Tabs_PreviewMouseWheel" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Open documents">
     <ListBox.Template><ControlTemplate TargetType="ListBox">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <RepeatButton x:Name="TabScrollLeftButton" Style="{StaticResource TabScrollButtonStyle}" Content="‹" Click="TabsScrollLeft_Click" ToolTip="Scroll tabs left" AutomationProperties.Name="Scroll tabs left"/>
       <ScrollViewer x:Name="PART_ScrollViewer" Grid.Column="1" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" SizeChanged="Tabs_SizeChanged">
        <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/></ControlTemplate></ScrollViewer.Template>
        <ItemsPresenter/>
       </ScrollViewer>
       <RepeatButton x:Name="TabScrollRightButton" Grid.Column="2" Style="{StaticResource TabScrollButtonStyle}" Content="›" Click="TabsScrollRight_Click" ToolTip="Scroll tabs right" AutomationProperties.Name="Scroll tabs right"/>
      </Grid>
      <ControlTemplate.Triggers><DataTrigger Binding="{Binding ScrollableWidth, ElementName=PART_ScrollViewer}" Value="0"><Setter TargetName="TabScrollLeftButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="TabScrollRightButton" Property="Visibility" Value="Collapsed"/></DataTrigger></ControlTemplate.Triggers>
     </ControlTemplate></ListBox.Template>
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Margin="0,0,3,0" Background="Transparent" CornerRadius="5,5,0,0" BorderBrush="Transparent" BorderThickness="1,2,1,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource WindowBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding FilePath}"><Button DockPanel.Dock="Right" Content="×" Padding="7,2" MinHeight="30" Click="CloseTab_Click" AutomationProperties.Name="Close tab"/><TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextBrush}" Margin="12,8,8,8" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
     <Button Content="−" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out"/>
     <Button x:Name="ZoomButton" Content="100%" Click="ZoomReset_Click" ToolTip="Reset zoom (Ctrl+0)"/>
     <Button Content="+" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in"/>
     <Button x:Name="MoreButton" Content="⋯" Click="More_Click" Margin="6,0,0,0" ToolTip="More options" AutomationProperties.Name="More options"/>
    </StackPanel>
    <Border x:Name="TitleBarDragArea" Grid.Column="3" Background="Transparent"/>
    <StackPanel x:Name="CaptionButtonsSpace" Grid.Column="4" Orientation="Horizontal">
     <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="{StaticResource WindowMinimizeIcon}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
     <Button x:Name="MaximizeButton" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"><Setter Property="Content" Value="{StaticResource WindowMaximizeIcon}"/><Setter Property="ToolTip" Value="Maximize"/><Setter Property="AutomationProperties.Name" Value="Maximize"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="{StaticResource WindowRestoreIcon}"/><Setter Property="ToolTip" Value="Restore"/><Setter Property="AutomationProperties.Name" Value="Restore"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button x:Name="CloseWindowButton" Style="{StaticResource CloseCaptionButtonStyle}" Content="{StaticResource WindowCloseIcon}" Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" AutomationProperties.Name="Close"/>
    </StackPanel>
  </Grid>
  <Border x:Name="SearchPanel" Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,7" Visibility="Collapsed">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="SearchCount" Text="Enter search text" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="12,0"/><Button Content="↑" Click="FindPrevious_Click" AutomationProperties.Name="Previous match"/><Button Content="↓" Click="FindNext_Click" AutomationProperties.Name="Next match"/><Button Content="×" Click="CloseFind_Click" AutomationProperties.Name="Close search"/></StackPanel>
    <TextBox x:Name="SearchBox" MaxWidth="420" HorizontalAlignment="Stretch" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" AutomationProperties.Name="Find in document"/>
   </DockPanel>
  </Border>
  <Border x:Name="NoticePanel" Grid.Row="2" Background="{DynamicResource SelectedBrush}" Padding="12,7" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissNotice_Click" MinHeight="24" Padding="6,0" AutomationProperties.Name="Dismiss notification"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
  <Grid Grid.Row="3" Background="{DynamicResource WindowBrush}">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="OutlineColumn" Width="220" MaxWidth="400"/><ColumnDefinition x:Name="SplitterColumn" Width="4"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Border x:Name="OutlinePanel" Background="{DynamicResource SidebarBrush}" Padding="10,18,10,8">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="ON THIS PAGE" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,14"/><TextBlock x:Name="EmptyOutline" DockPanel.Dock="Top" Text="This document has no headings" TextWrapping="Wrap" Margin="10,0" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/><ListBox x:Name="OutlineList" BorderThickness="0" Background="Transparent" SelectionChanged="Outline_SelectionChanged" ItemContainerStyle="{StaticResource OutlineItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Document outline"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="{Binding Indent}"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
   </Border>
   <GridSplitter x:Name="OutlineSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}" ResizeDirection="Columns" DragCompleted="OutlineSplitter_DragCompleted"/>
   <Grid Grid.Column="2">
    <RichTextBox x:Name="Reader" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsDocumentEnabled="True" IsUndoEnabled="False" IsInactiveSelectionHighlightEnabled="True" SelectionBrush="{DynamicResource AccentBrush}" SelectionOpacity="0.35" BorderThickness="0" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0" PreviewMouseWheel="Reader_PreviewMouseWheel" ScrollViewer.ScrollChanged="Reader_ScrollChanged" SizeChanged="Reader_SizeChanged" AutomationProperties.Name="Markdown content"/>
    <Border x:Name="WelcomePanel" Background="{DynamicResource WindowBrush}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="440"><TextBlock Text="Markdown Viewer" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/><Button Content="Open files…" Click="Open_Click" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="20,9"/><ItemsControl x:Name="WelcomeRecents" Margin="0,20,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" ToolTip="{Binding Path}" Tag="{Binding Path}" Click="WelcomeRecent_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5"><DockPanel><TextBlock x:Name="EncodingText" DockPanel.Dock="Right" Text="UTF-8" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="15,0,0,0"/><TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
