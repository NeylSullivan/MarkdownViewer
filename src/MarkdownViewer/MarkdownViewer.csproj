<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MarkdownViewer.ico</ApplicationIcon>
    <AssemblyName>MarkdownViewer</AssemblyName>
    <Version>1.0.0</Version>
    <Description>A lightweight Markdown viewer for Windows</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\MarkdownViewer.ico" />
    <Resource Include="Assets\MarkdownViewer.ico" />
  </ItemGroup>
</Project>
